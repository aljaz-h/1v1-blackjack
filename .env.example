# Required: the master password everyone types to enter the site
SITE_PASSWORD=change-me

# Recommended: extra secret mixed into the login-token signature
AUTH_SECRET=some-long-random-string

# Vercel (or any multi-instance deploy) ONLY: Upstash Redis REST credentials.
# Vercel's Upstash/KV integration injects these automatically.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional tuning
# PORT=3000
# POLL_MS=700          # Redis polling interval for live updates (Vercel mode)
